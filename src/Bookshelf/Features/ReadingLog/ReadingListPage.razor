@page "/reading-list"
@implements IAsyncDisposable
@inject ReadingService Readings
@inject BookService Books
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Reading list · Bookshelf</PageTitle>

<MudButton Href="./" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-2">The Shelf</MudButton>

<div class="page-heading">
    <MudText Typo="Typo.h4" HtmlTag="h1">Reading list</MudText>
    <MudText Typo="Typo.body2" Class="text-secondary" data-testid="queue-count">@CountLabel</MudText>
</div>

@if (_others.Count > 0)
{
    <div class="filter-chips" role="tablist" aria-label="Whose list">
        <button type="button" role="tab" class="filter-chip @(_viewing is null ? "selected" : null)"
                aria-selected="@(_viewing is null ? "true" : "false")" @onclick="() => ShowAsync(null)" data-testid="list-mine">Mine</button>
        @foreach (var (uid, name) in _others)
        {
            var who = uid;
            <button type="button" role="tab" class="filter-chip @(_viewing == who ? "selected" : null)"
                    aria-selected="@(_viewing == who ? "true" : "false")" @onclick="() => ShowAsync(who)" data-testid="list-other">
                @(string.IsNullOrWhiteSpace(name) ? "Someone" : name)
            </button>
        }
    </div>
}

@if (_rows is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <div class="empty-shelf" data-testid="queue-empty">
        <MudIcon Icon="@Icons.Material.Filled.BookmarkBorder" Size="Size.Large" Color="Color.Primary" />
        @if (_viewing is null)
        {
            <MudText Typo="Typo.h6">Nothing queued yet</MudText>
            <MudText Typo="Typo.body2">Tap “Want to read” on any book to add it here, or add one you don't own yet.</MudText>
            <MudButton Variant="Variant.Text" Href="find" StartIcon="@Icons.Material.Filled.TravelExplore" Class="mt-2">Find a book online</MudButton>
        }
        else
        {
            <MudText Typo="Typo.h6">Nothing on this list</MudText>
        }
    </div>
}
else
{
    @if (_viewing is null)
    {
        <MudText Typo="Typo.caption" Class="text-secondary d-block mb-2">Drag <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Style="vertical-align: middle" /> to reorder.</MudText>
    }
    <ol class="queue-list" @ref="_list" data-testid="queue">
        @for (var i = 0; i < _rows.Count; i++)
        {
            var index = i;
            var row = _rows[i];
            <li class="queue-row" @key="row.Book.Id" data-index="@index" data-testid="queue-row">
                @if (_viewing is null)
                {
                    <span class="drag-handle" data-drag-handle aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" />
                    </span>
                }
                <span class="queue-number">@(index + 1)</span>
                <a class="queue-book" href="books/@row.Book.Id">
                    <BookCover Book="row.Book" />
                    <span class="queue-text">
                        <MudText Typo="Typo.subtitle1" Class="book-row-title">@row.Book.Title</MudText>
                        @if (!string.IsNullOrEmpty(row.Book.Author))
                        {
                            <MudText Typo="Typo.body2" Class="book-row-author">@row.Book.Author</MudText>
                        }
                        @if (row.Book.OnWishlist)
                        {
                            <span class="status-badge" data-testid="wishlist-tag">Not on the shelf yet</span>
                        }
                    </span>
                </a>
                @if (_viewing is null)
                {
                    <div class="queue-actions">
                        @if (index == 0)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="() => StartAsync(row.Book)"
                                       data-testid="start-reading">Start</MudButton>
                        }
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AriaLabel="@($"Options for {row.Book.Title}")"
                                 data-testid="queue-menu">
                            @if (index > 0)
                            {
                                <MudMenuItem OnClick="() => MoveAsync(row.Book, 0)" data-testid="move-top">Move to top</MudMenuItem>
                                <MudMenuItem OnClick="() => MoveAsync(row.Book, index - 1)" data-testid="move-up">Move up</MudMenuItem>
                            }
                            @if (index < _rows.Count - 1)
                            {
                                <MudMenuItem OnClick="() => MoveAsync(row.Book, index + 1)" data-testid="move-down">Move down</MudMenuItem>
                            }
                            <MudMenuItem OnClick="() => StartAsync(row.Book)" data-testid="menu-start">Start reading</MudMenuItem>
                            <MudMenuItem OnClick="() => RemoveAsync(row.Book)" data-testid="remove-from-list">Remove from list</MudMenuItem>
                        </MudMenu>
                    </div>
                }
            </li>
        }
    </ol>
}

@code {
    private sealed record Row(Book Book, Reading Reading);

    private List<Row>? _rows;
    private IReadOnlyList<(string Uid, string Name)> _others = [];
    private string? _viewing;
    private ElementReference _list;
    private DotNetObjectReference<ReadingListPage>? _ref;
    private IJSObjectReference? _module;

    private string CountLabel => _rows is null ? "" : _rows.Count == 1 ? "1 book" : $"{_rows.Count} books";

    protected override async Task OnInitializedAsync()
    {
        Readings.Changed += OnChanged;
        Books.Changed += OnChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Attach drag-to-reorder whenever my list is showing (it's re-created when switching tabs).
        if (_viewing is null && _rows is { Count: > 1 })
        {
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/reorder.js");
                _ref ??= DotNetObjectReference.Create(this);
                if (_module is not null)
                {
                    await _module.InvokeVoidAsync("attach", _list, _ref);
                }
            }
            catch (JSException)
            {
                // Dragging is a nicety; the menu still moves books.
            }
        }
    }

    private async Task LoadAsync()
    {
        var uid = _viewing ?? Readings.MyUid;
        if (uid is null)
        {
            _rows = [];
            return;
        }

        var books = (await Books.GetAllAsync()).ToDictionary(b => b.Id);
        _rows = [.. (await Readings.GetQueueAsync(uid))
            .Where(r => books.ContainsKey(r.BookId))
            .Select(r => new Row(books[r.BookId], r))];
        _others = await Readings.GetOtherListsAsync();
    }

    private async Task ShowAsync(string? uid)
    {
        _viewing = uid;
        _rows = null;
        await LoadAsync();
    }

    [JSInvokable]
    public Task OnReorder(int from, int to) => InvokeAsync(async () =>
    {
        if (_viewing is null && _rows is not null && from >= 0 && from < _rows.Count)
        {
            await MoveAsync(_rows[from].Book, to);
            StateHasChanged();
        }
    });

    private async Task MoveAsync(Book book, int toIndex)
    {
        await Readings.MoveInQueueAsync(book.Id, toIndex);
        await LoadAsync();
    }

    private async Task StartAsync(Book book)
    {
        await Readings.SetStatusAsync(book.Id, ReadingStatus.Reading);
        await LoadAsync();
        Snackbar.Add(book.OnWishlist
            ? $"Enjoy “{book.Title}”. It's still on the wishlist until you tap “Got it” on its page."
            : $"Enjoy “{book.Title}”. It's at the top of the shelf.", Severity.Success);
    }

    private async Task RemoveAsync(Book book)
    {
        await Readings.SetStatusAsync(book.Id, null);
        await LoadAsync();
        Snackbar.Add($"Took “{book.Title}” off your list.", Severity.Info);
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Readings.Changed -= OnChanged;
        Books.Changed -= OnChanged;
        _ref?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
