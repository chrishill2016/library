@page "/"
@implements IDisposable
@inject BookService Books
@inject ReadingService Readings

<PageTitle>Bookshelf</PageTitle>

<div class="page-heading">
    <MudText Typo="Typo.h4" HtmlTag="h1">The Shelf</MudText>
    @if (_all is not null)
    {
        <MudText Typo="Typo.body2" Class="text-secondary" data-testid="book-count">@CountLabel</MudText>
    }
</div>

<div class="shelf-toolbar">
    <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged" Immediate="true"
                  Placeholder="Search title, author or ISBN" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Class="shelf-search" data-testid="search" />
    <MudSelect T="BookSort" Value="_sort" ValueChanged="OnSortChanged" Variant="Variant.Outlined"
               Margin="Margin.Dense" Label="Sort by" Class="shelf-sort">
        <MudSelectItem Value="BookSort.Title">Title</MudSelectItem>
        <MudSelectItem Value="BookSort.Author">Author</MudSelectItem>
        <MudSelectItem Value="BookSort.RecentlyAdded">Recently added</MudSelectItem>
        <MudSelectItem Value="BookSort.MyRating">My rating</MudSelectItem>
    </MudSelect>
</div>

@if (_all is { Count: > 0 })
{
    <div class="filter-chips" role="group" aria-label="Show">
        @foreach (var (filter, label) in Filters)
        {
            var selected = _filter == filter;
            <button type="button" class="filter-chip @(selected ? "selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                    @onclick="() => OnFilterChanged(filter)" data-testid="@($"filter-{filter}")">@label</button>
        }
    </div>
}

@if (_all is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_all.Count == 0)
{
    <div class="empty-shelf">
        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Your shelf is empty</MudText>
        <MudText Typo="Typo.body2">Scan a barcode to add your first book.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="scan" StartIcon="@AppIcons.Barcode" Class="mt-3">Scan books</MudButton>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Text" Href="find" StartIcon="@Icons.Material.Filled.TravelExplore">Find online</MudButton>
            <MudButton Variant="Variant.Text" Href="books/new" StartIcon="@Icons.Material.Filled.Edit">Type it in</MudButton>
        </div>
    </div>
}
else if (_visible.Count == 0)
{
    <MudText Typo="Typo.body1" Class="mt-6 text-center" data-testid="no-matches">@NoMatchesMessage</MudText>
}
else
{
    @if (_readingNow.Count > 0)
    {
        <MudText Typo="Typo.overline" HtmlTag="h2" Class="shelf-section">Reading now</MudText>
        <div class="book-list mb-3" data-testid="reading-now">
            @foreach (var book in _readingNow)
            {
                <BookListItem @key="book.Id" Book="book" Mine="Mine(book)" />
            }
        </div>
        @if (_rest.Count > 0)
        {
            <MudText Typo="Typo.overline" HtmlTag="h2" Class="shelf-section">On the shelf</MudText>
        }
    }
    <div class="book-list" data-testid="book-list">
        <Virtualize Items="_rest" Context="book" ItemSize="96" OverscanCount="8">
            <BookListItem @key="book.Id" Book="book" Mine="Mine(book)" />
        </Virtualize>
    </div>
}

<div class="fab-stack">
    <MudFab Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Href="books/new" aria-label="Add a book by hand or search" data-testid="add-fab" />
    <MudFab Color="Color.Primary" StartIcon="@AppIcons.Barcode" Href="scan" aria-label="Scan books" data-testid="scan-fab" />
</div>

@code {
    private static readonly (ReadingFilter Filter, string Label)[] Filters =
    [
        (ReadingFilter.All, "All"),
        (ReadingFilter.Reading, "Reading"),
        (ReadingFilter.WantToRead, "Want to read"),
        (ReadingFilter.Read, "Read"),
        (ReadingFilter.NotRead, "Not read"),
        (ReadingFilter.Wishlist, "Wishlist"),
    ];

    private IReadOnlyList<Book>? _all;
    private IReadOnlyDictionary<string, Reading> _mine = new Dictionary<string, Reading>();
    private List<Book> _visible = [];
    private List<Book> _readingNow = [];
    private List<Book> _rest = [];
    private string _query = "";
    private BookSort _sort = BookSort.Title;
    private ReadingFilter _filter = ReadingFilter.All;

    private Reading? Mine(Book book) => _mine.GetValueOrDefault(book.Id);

    private string NoMatchesMessage => (_query.Trim(), _filter) switch
    {
        ("", ReadingFilter.All) => "Nothing on the shelf yet, only wishlist books.",
        ("", ReadingFilter.Wishlist) => "Nothing on the wishlist. Add books you'd like from “Find online”.",
        ("", var f) => $"No books marked “{Filters.First(x => x.Filter == f).Label}”.",
        (var q, ReadingFilter.All) => $"No books match “{q}”.",
        (var q, var f) => $"No “{Filters.First(x => x.Filter == f).Label}” books match “{q}”.",
    };

    private int ShelfCount => _all!.Count(b => !b.OnWishlist);

    private string CountLabel =>
        _filter == ReadingFilter.Wishlist
            ? $"{_visible.Count} on the wishlist"
            : _visible.Count == ShelfCount
                ? $"{ShelfCount} {(ShelfCount == 1 ? "volume" : "volumes")}"
                : $"{_visible.Count} of {ShelfCount} volumes";

    protected override async Task OnInitializedAsync()
    {
        Books.Changed += OnBooksChanged;
        Readings.Changed += OnBooksChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _all = await Books.GetAllAsync();
        _mine = await Readings.GetMyReadingsAsync();
        Apply();
    }

    private void Apply()
    {
        var matching = BookSearch.FilterByReading(BookSearch.Filter(_all ?? [], _query), _filter, Mine);
        _visible = [.. BookSearch.Sort(matching, _sort, Mine)];
        // On the full shelf, books being read now are pinned at the top.
        _readingNow = _filter == ReadingFilter.All ? [.. _visible.Where(b => Mine(b)?.Status == ReadingStatus.Reading)] : [];
        _rest = _readingNow.Count == 0 ? _visible : [.. _visible.Except(_readingNow)];
    }

    private void OnFilterChanged(ReadingFilter filter)
    {
        _filter = filter;
        Apply();
    }

    private void OnQueryChanged(string? value)
    {
        _query = value ?? "";
        Apply();
    }

    private void OnSortChanged(BookSort value)
    {
        _sort = value;
        Apply();
    }

    private void OnBooksChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Books.Changed -= OnBooksChanged;
        Readings.Changed -= OnBooksChanged;
    }
}
