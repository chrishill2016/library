@page "/books/new"
@page "/books/{Id}/edit"
@inject BookService Books
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IBookLookup Lookup
@inject Bookshelf.Features.Photos.PhotoService Photos
@inject Bookshelf.Features.ReadingLog.ReadingService Readings

<PageTitle>@(IsNew ? "Add a book" : "Edit book") · Bookshelf</PageTitle>

<MudButton Href="@BackHref" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Class="mb-2">Back</MudButton>

@if (_form is null)
{
    @if (_notFound)
    {
        <MudText Typo="Typo.h6">This book isn't on the shelf.</MudText>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
}
else
{
    <MudPaper Class="pa-4 tooled-panel" Elevation="3">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">@(IsNew ? "Add a book" : "Edit book")</MudText>
        @if (IsNew)
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">
                Quicker: <MudLink Href="scan">scan the barcode</MudLink> or <MudLink Href="find">find it online</MudLink>.
            </MudText>
        }
        @* The title is only checked on Save: checking on blur showed the error (and shifted
           the layout) when tapping Back or Cancel, so the tap missed the button. *@
        <MudForm>
            <MudTextField T="string" Value="_form.Title" ValueChanged="OnTitleChanged" Label="Title" Immediate="true"
                          Error="_titleMissing" ErrorText="Every book needs a title."
                          Variant="Variant.Outlined" Class="mb-3" AutoFocus="@IsNew" data-testid="title" />
            <MudTextField @bind-Value="_form.Author" Label="Author" Variant="Variant.Outlined" Class="mb-3"
                          HelperText="Separate several authors with “&”." data-testid="author" />
            <div class="form-row">
                <MudTextField @bind-Value="_form.Isbn" Label="ISBN" Variant="Variant.Outlined" Immediate="true"
                              InputMode="InputMode.numeric" HelperText="@_form.IsbnWarning" data-testid="isbn"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.TravelExplore"
                              AdornmentAriaLabel="Look up this ISBN online" OnAdornmentClick="LookUpIsbnAsync" />
                <MudNumericField @bind-Value="_form.PublishedYear" Label="Year" Variant="Variant.Outlined"
                                 Min="1000" Max="2100" HideSpinButtons="true" data-testid="year" />
            </div>
            <MudTextField @bind-Value="_form.Publisher" Label="Publisher" Variant="Variant.Outlined" Class="mb-3" />
            @if (_form.IsNew)
            {
                <MudSwitch T="bool" @bind-Value="_form.OnWishlist" Color="Color.Primary" Class="mb-3" data-testid="wishlist-switch"
                           Label="Not on the shelf yet: add to my reading list as a wishlist book" />
            }
            <div class="edit-cover mb-3">
                <BookCover Book="@_form.ToBook()" />
                <div class="edit-cover-actions">
                    <PhotoButton Label="@(_form.PhotoId is null ? "Take cover photo" : "Replace photo")" Size="Size.Small"
                                 OnCaptured="photo => _form.PhotoId = photo.Id" />
                    @if (_form.PhotoId is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => _form.PhotoId = null"
                                   data-testid="remove-photo">Remove photo</MudButton>
                    }
                </div>
            </div>
            <MudTextField @bind-Value="_form.CoverUrl" Label="Cover image link (optional)" Variant="Variant.Outlined" Class="mb-3"
                          HelperText="Filled in by scanning. Your own photo is shown instead when there is one." InputType="InputType.Url" />
            <MudTextField @bind-Value="_form.Synopsis" Label="Synopsis" Variant="Variant.Outlined" Lines="4" Sizing="InputSizing.Auto"
                          MaxLength="Bookshelf.Features.Lookup.LookupText.MaxSynopsis" Class="mb-3" data-testid="synopsis"
                          HelperText="What the book is about. Filled in when the book is found online." />
            <GenrePicker @bind-Selected="_form.Genres" />
            <MudTextField @bind-Value="_form.Notes" Label="Notes" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" Class="mb-3 mt-3" />
        </MudForm>
        <div class="d-flex gap-2 justify-end">
            <MudButton Variant="Variant.Text" Href="@BackHref">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving"
                       StartIcon="@Icons.Material.Filled.Save" data-testid="save">Save</MudButton>
        </div>
    </MudPaper>
}

@code {
    private BookForm? _form;
    private bool _titleMissing;
    private bool _saving;
    private bool _notFound;

    [Parameter] public string? Id { get; set; }

    /// <summary><c>books/new?wishlist=true</c> starts the form as a wishlist book.</summary>
    [SupplyParameterFromQuery] public bool Wishlist { get; set; }

    private bool IsNew => string.IsNullOrEmpty(Id);

    // "./" (the shelf), not "": MudButton treats an empty Href as "not a link" and does nothing.
    private string BackHref => IsNew ? "./" : $"books/{Id}";

    private async Task LookUpIsbnAsync()
    {
        if (_form is null || !Isbn.IsValid(_form.Isbn))
        {
            Snackbar.Add("Enter a valid ISBN first.", Severity.Warning);
            return;
        }

        var result = await Lookup.LookupIsbnAsync(_form.Isbn!);
        switch (result.Outcome)
        {
            case LookupOutcome.Found:
                _form.Apply(result.Book!);
                Snackbar.Add("Details filled in. Check them, then save.", Severity.Success);
                break;
            case LookupOutcome.NotFound:
                Snackbar.Add("No details found online for that ISBN.", Severity.Info);
                break;
            default:
                Snackbar.Add("Couldn't reach the book catalogues. Are you online?", Severity.Warning);
                break;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            _form = new BookForm { OnWishlist = Wishlist };
            return;
        }

        var book = await Books.GetAsync(Id!);
        _notFound = book is null;
        _form = book is null ? null : BookForm.From(book);
    }

    private void OnTitleChanged(string? value)
    {
        _form!.Title = value ?? "";
        if (_titleMissing && !string.IsNullOrWhiteSpace(value))
        {
            _titleMissing = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form!.Title))
        {
            _titleMissing = true;
            return;
        }

        _saving = true;
        var isNewWishlist = _form!.IsNew && _form.OnWishlist;
        var saved = await Books.SaveAsync(_form!.ToBook());
        if (isNewWishlist && Readings.MyUid is not null)
        {
            await Readings.SetStatusAsync(saved.Id, ReadingStatus.WantToRead);
        }

        await Photos.PhotoChangedAsync(previous: _form.OriginalPhotoId, current: saved.PhotoId);
        Snackbar.Add(!IsNew ? "Saved."
            : isNewWishlist ? $"Added “{saved.Title}” to your reading list."
            : $"Added “{saved.Title}” to the shelf.", Severity.Success);
        Nav.NavigateTo($"books/{saved.Id}", replace: true);
    }
}
