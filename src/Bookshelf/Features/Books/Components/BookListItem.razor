<a class="book-row" href="books/@Book.Id">
    <BookCover Book="Book" />
    <div class="book-row-text">
        <MudText Typo="Typo.subtitle1" Class="book-row-title">@Book.Title</MudText>
        @if (!string.IsNullOrEmpty(Book.Author))
        {
            <MudText Typo="Typo.body2" Class="book-row-author">@Book.Author</MudText>
        }
        @if (Book.LookupState == BookLookupState.Pending)
        {
            <MudText Typo="Typo.caption" Class="lookup-flag" data-testid="lookup-pending">Details coming when online</MudText>
        }
        else if (Book.LookupState == BookLookupState.NotFound)
        {
            <MudText Typo="Typo.caption" Class="lookup-flag" data-testid="lookup-notfound">Not found online · tap to add details</MudText>
        }
        else if (Mine is { Rating: not null } or { Status: not null } || Book.PublishedYear is not null)
        {
            <div class="book-row-meta">
                @if (Mine?.Rating is { } rating)
                {
                    <StarRating Value="rating" ReadOnly="true" Size="Size.Small" TestId="row-rating" />
                }
                @if (Mine?.Status is { } status)
                {
                    <span class="status-badge status-@status" data-testid="row-status">@ReadingStatus.Label(status)</span>
                }
                @if (Book.PublishedYear is { } year)
                {
                    <MudText Typo="Typo.caption" Class="text-secondary">@year</MudText>
                }
            </div>
        }
    </div>
    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="book-row-chevron" />
</a>

@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = default!;

    /// <summary>The signed-in person's reading of this book, if any.</summary>
    [Parameter] public Reading? Mine { get; set; }
}
