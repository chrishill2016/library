@inject PhotoService Photos
@inject ISnackbar Snackbar

@* Labels styled as buttons open hidden file inputs. capture="environment" makes Android open the rear camera
   straight away; the gallery input has no capture, so it offers existing pictures. *@
<input type="file" accept="image/*" capture="environment" id="@_cameraId" class="visually-hidden" @ref="_camera"
       @onchange="() => OnFileChosenAsync(_camera)" data-testid="photo-input" />
<input type="file" accept="image/*" id="@_galleryId" class="visually-hidden" @ref="_gallery"
       @onchange="() => OnFileChosenAsync(_gallery)" data-testid="photo-gallery-input" />
<span class="photo-buttons">
    <MudButton HtmlTag="label" for="@_cameraId" Variant="@Variant" Color="Color.Primary" Size="@Size"
               StartIcon="@Icons.Material.Filled.PhotoCamera" Disabled="_busy" data-testid="photo-button">
        @(_busy ? "Opening photo…" : Label)
    </MudButton>
    <MudTooltip Text="Choose from gallery">
        <MudIconButton HtmlTag="label" for="@_galleryId" Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary"
                       Size="@Size" Disabled="_busy" aria-label="Choose from gallery" data-testid="gallery-button" />
    </MudTooltip>
</span>
@if (_draft is { } draft)
{
    <CoverCropper Draft="draft" OnDone="OnCroppedAsync" />
}

@code {
    private readonly string _cameraId = $"photo-{Guid.NewGuid():N}";
    private readonly string _galleryId = $"gallery-{Guid.NewGuid():N}";
    private ElementReference _camera;
    private ElementReference _gallery;
    private bool _busy;
    private PhotoDraft? _draft;

    [Parameter] public string Label { get; set; } = "Photo";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Size Size { get; set; } = Size.Medium;

    /// <summary>Called with the cropped photo, stored on this device but not yet attached to a book.</summary>
    [Parameter] public EventCallback<CapturedPhoto> OnCaptured { get; set; }

    private async Task OnFileChosenAsync(ElementReference input)
    {
        _busy = true;
        try
        {
            _draft = await Photos.OpenDraftAsync(input);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't open that photo: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnCroppedAsync(CapturedPhoto? photo)
    {
        _draft = null;
        if (photo is not null)
        {
            await OnCaptured.InvokeAsync(photo);
        }
    }
}
