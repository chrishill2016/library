@page "/settings"
@implements IDisposable
@inject ThemeService Themes
@inject ISyncService Sync
@inject AuthService Auth
@inject IDialogService Dialogs
@inject Bookshelf.Features.Photos.PhotoService Photos
@inject DashboardPreferences DashboardPrefs
@inject Bookshelf.Features.Lookup.BookDetailsFiller Filler
@inject Bookshelf.Features.Lookup.IBookLookup BookLookup
@inject IConnectivityService Connectivity

<PageTitle>Settings · Bookshelf</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Settings</MudText>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">Library</MudText>
    <LibrarySettings />
</MudPaper>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">Sync</MudText>
    <MudText Typo="Typo.body2" Class="mb-1" data-testid="sync-summary">@SyncSummary</MudText>
    @if (Photos.PendingCount > 0)
    {
        <MudText Typo="Typo.body2" Class="mb-1" data-testid="photo-summary">
            @(Photos.PendingCount == 1 ? "1 cover photo" : $"{Photos.PendingCount} cover photos") waiting to upload.
        </MudText>
    }
    <div class="mb-2"></div>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync"
               OnClick="SyncNowAsync" Disabled="@(Sync.State.IsSyncing || !Sync.State.IsOnline || !Sync.State.RemoteConfigured)">Sync now</MudButton>
</MudPaper>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">Binding</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 text-secondary">Choose how the library looks on this device.</MudText>
    <div class="theme-grid">
        @foreach (var theme in ThemeRegistry.All)
        {
            var selected = theme.Key == Themes.Current.Key;
            <button type="button" class="theme-option @(selected ? "selected" : null)" aria-pressed="@(selected ? "true" : "false")"
                    @onclick="() => Themes.SetThemeAsync(theme.Key)">
                <span class="theme-swatches">
                    @foreach (var colour in theme.Swatches)
                    {
                        <span style="background:@colour"></span>
                    }
                </span>
                <span class="theme-name">@theme.Name</span>
                <span class="theme-description">@theme.Description</span>
            </button>
        }
    </div>
</MudPaper>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3" data-testid="fill-details">
    <MudText Typo="Typo.h6" Class="mb-2">Synopses &amp; genres</MudText>
    @if (Filler.IsRunning)
    {
        <MudText Typo="Typo.body2" Class="mb-2" data-testid="fill-progress">
            Checked @Filler.Checked of @Filler.Total; filled in @Filler.Filled so far…
        </MudText>
        <MudProgressLinear Color="Color.Primary" Value="@(Filler.Total == 0 ? 0 : 100.0 * Filler.Checked / Filler.Total)" Class="mb-2" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Filler.Stop" data-testid="fill-stop">Stop</MudButton>
    }
    else
    {
        @if (Filler.Total > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-2" data-testid="fill-result">
                Last run: filled in @Filler.Filled of the @Filler.Checked books checked.
                @Filler.StoppedReason
            </MudText>
            @foreach (var (source, problem) in BookLookup.Problems)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2" data-testid="source-problem">
                    @source didn't answer: “@problem”
                    @if (source == "Google Books")
                    {
                        <span> Synopses mostly come from Google Books. If it says the daily quota is used up, run this again tomorrow to carry on.</span>
                    }
                </MudAlert>
            }
        }
        <MudText Typo="Typo.body2" Class="mb-2 text-secondary" data-testid="fill-missing">
            @(_missing switch
            {
                0 => "Every book has a synopsis and genres.",
                1 => "1 book is missing a synopsis or genres.",
                var n => $"{n} books are missing a synopsis or genres.",
            })
            This looks them up on Google Books and Open Library. New books get theirs automatically when scanned or found online.
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                   Disabled="@(_missing == 0 || !Connectivity.IsOnline)" OnClick="FillAsync" data-testid="fill-start">
            Fill in missing details
        </MudButton>
        @if (!Connectivity.IsOnline)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-1 text-secondary">Needs an internet connection.</MudText>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">At a glance</MudText>
    <MudText Typo="Typo.body2" Class="mb-2 text-secondary">What “this year” means on the shelf summary and the At a glance page.</MudText>
    <MudRadioGroup T="StatsPeriod" Value="_period" ValueChanged="SetPeriodAsync" data-testid="stats-period">
        <MudRadio T="StatsPeriod" Value="StatsPeriod.CalendarYear" Color="Color.Primary" data-testid="period-calendar">Calendar year (since 1 January)</MudRadio>
        <MudRadio T="StatsPeriod" Value="StatsPeriod.Last12Months" Color="Color.Primary" data-testid="period-rolling">Last 12 months</MudRadio>
    </MudRadioGroup>
    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="dashboard" StartIcon="@Icons.Material.Filled.Insights" Class="mt-1">Open At a glance</MudButton>
</MudPaper>

<MudPaper Class="pa-4 mb-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">Account</MudText>
    @if (Auth.User is { } user)
    {
        <MudText Typo="Typo.body1">@user.Name</MudText>
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">@user.Email</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout"
                   OnClick="SignOutAsync" data-testid="sign-out">Sign out</MudButton>
    }
</MudPaper>

<MudPaper Class="pa-4 tooled-panel" Elevation="3">
    <MudText Typo="Typo.h6" Class="mb-2">About</MudText>
    <MudText Typo="Typo.body2">Bookshelf v@(AppInfo.Version)</MudText>
    <MudText Typo="Typo.caption" Class="text-secondary">Set in EB Garamond and Cormorant Garamond (SIL Open Font License).</MudText>
</MudPaper>

@code {
    private string SyncSummary => Sync.State switch
    {
        { IsOnline: false } => $"Offline. {Pending} Changes upload when you're back online.",
        { LastError: { } error } => $"Last sync failed: {error}",
        { PendingCount: > 0 } => Pending,
        _ => "Everything is up to date.",
    };

    private string Pending => Sync.State.PendingCount switch
    {
        0 => "No changes waiting.",
        1 => "1 change waiting to sync.",
        var n => $"{n} changes waiting to sync.",
    };

    private async Task SyncNowAsync()
    {
        await Sync.SyncNowAsync();
        await Photos.SyncAsync();
    }

    private async Task SignOutAsync()
    {
        var pending = Sync.State.PendingCount;
        var message = pending == 0
            ? "You'll need to sign in again to use Bookshelf."
            : $"{pending} {(pending == 1 ? "change hasn't" : "changes haven't")} synced yet. They stay on this device and upload when you sign back in with the same account.";
        var confirmed = await Dialogs.ShowMessageBoxAsync("Sign out?", message, yesText: "Sign out", cancelText: "Stay signed in");
        if (confirmed == true)
        {
            await Auth.SignOutAsync();
        }
    }

    private StatsPeriod _period;
    private int _missing;

    protected override async Task OnInitializedAsync()
    {
        _period = await DashboardPrefs.GetPeriodAsync();
        _missing = await Filler.CountMissingAsync();
    }

    private async Task FillAsync()
    {
        await Filler.RunAsync();
        _missing = await Filler.CountMissingAsync();
    }

    private async Task SetPeriodAsync(StatsPeriod period)
    {
        _period = period;
        await DashboardPrefs.SetPeriodAsync(period);
    }

    protected override void OnInitialized()
    {
        Themes.Changed += OnChanged;
        Sync.StateChanged += OnChanged;
        Photos.Changed += OnChanged;
        Filler.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Themes.Changed -= OnChanged;
        Sync.StateChanged -= OnChanged;
        Photos.Changed -= OnChanged;
        Filler.Changed -= OnChanged;
    }
}
